# Copie este arquivo para .env e preencha os valores reais.
# O .env já está no .gitignore — NUNCA versione segredos reais.
#   cp .env.example .env

# ---------- Banco de dados ----------
DB_USERNAME=postgres
DB_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=ecommerce_development

# ---------- App / URLs ----------
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---------- Mercado Pago ----------
# MP_ACCESS_TOKEN: Checkout Pro (cartao / Saldo logado).
#   Sandbox c/ login: APP_USR-... de um Seller Test User. Producao: APP_USR-... da conta real.
# MP_PIX_ACCESS_TOKEN: PIX (API de Pagamentos). Sandbox: TEST-... da conta real.
#   Em producao, pode usar o MESMO token de producao nas duas variaveis.
MP_ACCESS_TOKEN=
MP_PIX_ACCESS_TOKEN=

# ---------- JWT ----------
# Gere uma chave com: openssl rand -hex 64
DEVISE_JWT_SECRET_KEY=

# ---------- PayPal ----------
# Credenciais do app PayPal (Dashboard -> Apps & Credentials) e ID do webhook (Webhooks).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# true APENAS para testes locais; em produção deixe false com as credenciais acima preenchidas.
PAYPAL_SKIP_WEBHOOK_VERIFICATION=true

# ---------- PIX (opcional) ----------
# Cole aqui um BR Code (PIX copia-e-cola) válido se quiser PIX estático.
PIX_PAYLOAD=

# ---------- pgAdmin ----------
PGADMIN_DEFAULT_EMAIL=admin@example.com

# ---------- E-mail (Mailtrap / SMTP) ----------
# Pegue em: Mailtrap -> sua inbox (Sandbox) -> SMTP Settings -> integração "Ruby on Rails"
SMTP_ADDRESS=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_DOMAIN=sandbox.smtp.mailtrap.io
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
# Host/porta usados pelo mailer para montar URLs absolutas
MAILER_HOST=localhost
MAILER_PORT=3000
